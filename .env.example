# Copy to .env and fill in. Never commit .env or put a real key in this file.

# TTS engine: "piper" (default when empty; local, no credentials) or "seed" (production, via OpenRouter).
TTS_ENGINE=

# OpenRouter API key, used only when TTS_ENGINE=seed. Placeholder only; set the real key in your environment.
OPENROUTER_API_KEY=

# OpenRouter model id for Seed TTS. Empty uses the default, bytedance-seed/seed-audio-1-0.
SEED_TTS_MODEL=

# Seed speaker id (optional). Empty omits the voice field so the API default voice is used. Choose by listening test.
SEED_TTS_VOICE=

# LLM mode for the summarizer: "http" (default when empty; uses the LLM_API_* settings) or "kiro-cli" (runs the local Kiro CLI, which uses its own login). No secret goes here.
LLM_MODE=
